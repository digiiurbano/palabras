# Variables de Entorno — Backend JN Palabras

# Puerto del servidor (Render / Heroku lo asigna automáticamente)
PORT=3000

# URL del frontend para CORS (ej: en producción la URL de Vercel)
FRONTEND_URL=https://tu-app.vercel.app

# PostgreSQL Connection String (Supabase, Neon, Render, Railway, AWS RDS)
# Ej: postgres://usuario:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Opciones de conexión individual (alternativa a DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=jnpalabras
PGSSL=false
